<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.skillsgateway</groupId>
    <artifactId>skills-gateway-server</artifactId>
    <!-- Version is derived from git state by the Nisse core extension (ADR 0002). -->
    <version>${nisse.jgit.dynamicVersion}</version>
    <packaging>jar</packaging>

    <name>Skills Gateway</name>
    <description>Enterprise gateway for git-distributed AI agent skill marketplaces</description>
    <url>https://github.com/skillsgateway/skillsgateway</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <properties>
        <java.version>25</java.version>
        <jgit.version>7.7.1.202607240634-r</jgit.version>
        <reqstool-annotations.version>1.0.1</reqstool-annotations.version>
        <cel.version>0.14.0</cel.version>
        <spotless.version>3.10.0</spotless.version>
        <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
        <checkstyle.version>14.0.0</checkstyle.version>
        <native-plugin.version>1.1.11</native-plugin.version>
        <reqstool-plugin.version>1.1.0</reqstool-plugin.version>
        <arconia.version>0.30.0</arconia.version>
        <awssdk.version>2.54.5</awssdk.version>
        <spring-cloud-aws.version>4.1.1</spring-cloud-aws.version>
        <cyclonedx-plugin.version>2.9.3</cyclonedx-plugin.version>
        <springdoc.version>3.1.0</springdoc.version>
        <scalar.version>0.4.4</scalar.version>
        <!-- Skips the UI gate execution (typecheck/lint/vitest/tags) without skipping
             the UI build; used by the native workflow where no browsers exist. -->
        <skip.ui.verify>false</skip.ui.verify>
        <frontend-plugin.version>2.0.2</frontend-plugin.version>
        <node.version>v24.14.1</node.version>
        <pnpm.version>11.22.0</pnpm.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.arconia</groupId>
                <artifactId>arconia-bom</artifactId>
                <version>${arconia.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- AWS SDK v2. Test scope only today: the conditional-write fidelity
                 spike for the object-store storage backend (task 2.1 of the
                 pluggable-git-storage change) uses the same S3 client the
                 implementation would. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud AWS. Present so the Arconia Floci dev service can
                 activate: its auto-configuration is @ConditionalOnClass on
                 io.awspring.cloud.autoconfigure.core.AwsConnectionDetails. -->
            <dependency>
                <groupId>io.awspring.cloud</groupId>
                <artifactId>spring-cloud-aws-dependencies</artifactId>
                <version>${spring-cloud-aws.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- OpenAPI document only (no Swagger UI); the reference UI is Scalar. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.scalar.maven</groupId>
            <artifactId>scalar</artifactId>
            <version>${scalar.version}</version>
        </dependency>

        <!-- Boot 4 moved Flyway auto-configuration into its own module. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Embedded git server: JGit from day 1 (ADR 0002) -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>${jgit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit.http.server</artifactId>
            <version>${jgit.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.reqstool</groupId>
            <artifactId>reqstool-java-annotations</artifactId>
            <version>${reqstool-annotations.version}</version>
        </dependency>

        <!-- Embedded CEL evaluator for policy deny rules (ADR 0006): non-Turing-complete,
             terminating expressions over snapshot facts; never an OPA sidecar. -->
        <dependency>
            <groupId>dev.cel</groupId>
            <artifactId>cel</artifactId>
            <version>${cel.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The object-store git backend (skills-gateway.storage.backend=object-store). Compile
             scope because the backend is part of the application; it stays inert at runtime unless
             the backend is named, and the filesystem backend remains the default. apache5-client is
             the synchronous HTTP client, chosen explicitly so the connection pool can be given an
             idle time below the store's own; sts is what the web-identity (IRSA) credential
             provider needs, and web identity is a hard requirement rather than an option because
             the first deployment target has no instance metadata service. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache5-client</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
        </dependency>
        <!-- Floci (a local AWS emulator) through Arconia Dev Services, per the
             project rule that a dev service is used wherever one exists. The dev
             service activates only when Spring Cloud AWS is on the classpath, and
             the artifact that satisfies its @ConditionalOnClass —
             spring-cloud-aws-autoconfigure — is NOT sufficient on its own: it does
             not bring spring-cloud-aws-core, so awspring's own
             RegionProviderAutoConfiguration is silently skipped while its
             CredentialsProviderAutoConfiguration still activates and demands the
             AwsRegionProvider bean that was never created. Every Spring context in
             the project then fails to start. The starter brings both halves and the
             problem does not arise. Reported upstream as arconia-io/arconia#281.

             `optional`, alongside the Postgres dev service: the object-store backend
             now gives bootRun an object-store consumer to share the container with,
             which is the whole point of the project's dev-services rule — one
             container serves the development run and the test suite, so the thing
             developed against and the thing tested against cannot drift apart. -->
        <dependency>
            <groupId>io.arconia</groupId>
            <artifactId>arconia-dev-services-floci</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Only the Floci dev service needs this: the object-store backend builds its own
             S3 client from skills-gateway.storage.object-store.*, and never from Spring Cloud
             AWS. `optional` for the same reason as the dev service above — it must reach
             bootRun and the tests, and neither a consumer's classpath nor the packaged jar. -->
        <dependency>
            <groupId>io.awspring.cloud</groupId>
            <artifactId>spring-cloud-aws-starter-s3</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Dev/test-only, the Maven way: Maven has no environment-oriented scope, so
             `optional` is what keeps these off a consumer's classpath and out of the
             packaged jar (spring-boot:repackage defaults includeOptional=false). Plain
             `spring-boot:run` still sees them, which is how the dev services start
             without -Dspring-boot.run.useTestClasspath=true. -->
        <!-- Testcontainers via Arconia Dev Services: Postgres auto-starts in dev/test. -->
        <dependency>
            <groupId>io.arconia</groupId>
            <artifactId>arconia-dev-services-postgresql</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Opt-in local observability (Spring profile "observability"): the Grafana LGTM
             stack as a dev service plus OTLP export from the application. Disabled by
             default in application.yaml, so tests neither start the LGTM container nor
             initialise the OpenTelemetry SDK. -->
        <dependency>
            <groupId>io.arconia</groupId>
            <artifactId>arconia-dev-services-lgtm</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.arconia</groupId>
            <artifactId>arconia-opentelemetry-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- JDK 23+ no longer runs classpath-discovered annotation processors;
                         reqstool's processor (and its Jackson deps) must be on the processor path. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.github.reqstool</groupId>
                            <artifactId>reqstool-java-annotations</artifactId>
                            <version>${reqstool-annotations.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- BuildProperties carries the Nisse-derived version into the
                         served OpenAPI document (GW_0105). -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>config/checkstyle/checkstyle.xml</configLocation>
                    <propertyExpansion>config_loc=${project.basedir}/config/checkstyle</propertyExpansion>
                    <failOnViolation>true</failOnViolation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                        <!-- Before test/package so tests and the jar both see the BOM
                             on the classpath where the actuator sbom endpoint finds it. -->
                        <phase>generate-resources</phase>
                    </execution>
                </executions>
                <configuration>
                    <outputDirectory>${project.build.outputDirectory}/META-INF/sbom</outputDirectory>
                    <outputName>application.cdx</outputName>
                    <outputFormat>json</outputFormat>
                </configuration>
            </plugin>

            <!-- Portal build (ADR 0002/0003): the UI is built and gated inside the
                 Maven lifecycle and packaged into the jar's static resources. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-plugin.version}</version>
                <configuration>
                    <workingDirectory>src/main/frontend</workingDirectory>
                    <installDirectory>src/main/frontend</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-pnpm</id>
                        <goals>
                            <goal>install-node-and-pnpm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <pnpmVersion>${pnpm.version}</pnpmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pnpm-install</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <configuration>
                            <arguments>install --frozen-lockfile</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pnpm-verify</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <phase>test</phase>
                        <configuration>
                            <arguments>run verify</arguments>
                            <skip>${skip.ui.verify}</skip>
                        </configuration>
                    </execution>
                    <!-- process-classes, not prepare-package: spring-boot:run forks the
                         lifecycle only as far as test-compile, so a bundle built at
                         packaging time would leave the dev run serving a whitelabel page. -->
                    <execution>
                        <id>pnpm-build</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <phase>process-classes</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-portal-bundle</id>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <!-- Same phase as pnpm-build, declared after it so it copies what
                             that execution just produced. -->
                        <phase>process-classes</phase>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/frontend/dist</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>io.github.reqstool</groupId>
                <artifactId>reqstool-maven-plugin</artifactId>
                <version>${reqstool-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>assemble-and-attach-zip-artifact</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <datasetPath>${project.basedir}/docs/reqstool</datasetPath>
                    <outputDirectory>${project.build.directory}/reqstool</outputDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Release profile only — daily dev runs on JIT (ADR 0002). -->
        <profile>
            <id>native</id>
            <!-- native-image compiles from this project's own runtime classpath, which
                 `optional` does not narrow — left alone it links Testcontainers and the
                 dev services into the binary. Test scope here keeps them out; verify with
                 `strings target/skills-gateway-server | grep -c org.testcontainers`. -->
            <dependencies>
                <dependency>
                    <groupId>io.arconia</groupId>
                    <artifactId>arconia-dev-services-postgresql</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>io.arconia</groupId>
                    <artifactId>arconia-dev-services-lgtm</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>io.arconia</groupId>
                    <artifactId>arconia-dev-services-floci</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>io.awspring.cloud</groupId>
                    <artifactId>spring-cloud-aws-starter-s3</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>io.arconia</groupId>
                    <artifactId>arconia-opentelemetry-spring-boot-starter</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <buildArgs>
                                <!-- Mostly-static: everything statically linked except glibc,
                                     so the binary runs on distroless *base* (no libz there). -->
                                <buildArg>--static-nolibc</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
