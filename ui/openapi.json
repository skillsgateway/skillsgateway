{"openapi":"3.1.0","info":{"title":"Skills Gateway","description":"Enterprise gateway for git-distributed AI agent skill marketplaces (Claude Code plugins, Copilot, Cursor).\n\nUpstream marketplaces are ingested into quarantine as immutable, SHA-identified snapshots, held until a reviewer approves them, and served to unmodified git clients over smart-HTTP — only approved content is ever fetchable, and every fetch lands in an append-only audit ledger.\n\nBrowser sessions authenticate via OIDC; git clients authenticate with personal access tokens over the standard credential-helper flow. This API is the same surface the admin portal uses.","contact":{"name":"jimisola","url":"https://github.com/jimisola/skills-gateway"},"license":{"name":"Apache-2.0","url":"https://www.apache.org/licenses/LICENSE-2.0"},"version":"v1"},"externalDocs":{"description":"Architecture, ADRs, and requirements (reqstool SSOT)","url":"https://github.com/jimisola/skills-gateway#documentation"},"servers":[{"url":"http://localhost","description":"Generated server url"}],"tags":[{"name":"Marketplaces","description":"Register upstream marketplaces and ingest them into held snapshots"},{"name":"Snapshots","description":"Approve or reject held snapshots and retrieve their provenance"},{"name":"Audit","description":"Append-only ledger of every git facade fetch"},{"name":"Tokens","description":"Personal access tokens for git clients (hashed at rest, shown once)"},{"name":"Session","description":"Identity of the authenticated browser session"}],"paths":{"/api/tokens":{"get":{"tags":["token-controller"],"operationId":"list","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/TokenView"}}}}}}},"post":{"tags":["token-controller"],"operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateTokenRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IssuedToken"}}}}}}},"/api/snapshots/{id}/reject":{"post":{"tags":["Snapshots"],"summary":"Reject a held snapshot","description":"Marks the snapshot rejected with the reviewer identity and timestamp; its content is never served.","operationId":"reject","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Snapshot rejected","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Snapshot"}}}},"404":{"description":"Snapshot not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Snapshot"}}}},"409":{"description":"Snapshot is not in the held state","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Snapshot"}}}}}}},"/api/snapshots/{id}/approve":{"post":{"tags":["Snapshots"],"summary":"Approve a held snapshot","description":"Publishes the snapshot to the git facade and records the reviewer identity and timestamp. Only held snapshots can be approved.","operationId":"approve","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Snapshot approved and now served","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Snapshot"}}}},"404":{"description":"Snapshot not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Snapshot"}}}},"409":{"description":"Snapshot is not in the held state","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Snapshot"}}}}}}},"/api/marketplaces":{"get":{"tags":["Marketplaces"],"summary":"List marketplaces and their snapshots","description":"All registered marketplaces with every snapshot and its state (held, approved, or rejected).","operationId":"listMarketplaces","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/MarketplaceView"}}}}}}},"post":{"tags":["Marketplaces"],"summary":"Register a marketplace","description":"Registers an upstream git skill marketplace by clone URL. The URL scheme must be on the configured allowlist (default http/https). The ingested ref is set by the gateway (the upstream default branch) and cannot be overridden; a request supplying any other ref is rejected.","operationId":"registerMarketplace","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterMarketplaceRequest"}}},"required":true},"responses":{"201":{"description":"Marketplace registered","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Marketplace"}}}},"400":{"description":"Disallowed URL scheme, or a ref other than the default branch","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Marketplace"}}}},"409":{"description":"A marketplace with that name already exists","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Marketplace"}}}},"422":{"description":"Invalid marketplace name","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Marketplace"}}}}}}},"/api/marketplaces/{name}/ingest":{"post":{"tags":["Marketplaces"],"summary":"Ingest the upstream default branch","description":"Fetches the marketplace's upstream default branch into quarantine and records an immutable snapshot pinned to the upstream commit SHA. The snapshot is held until a reviewer approves it; manifests declaring non-local plugin sources are rejected.","operationId":"ingest","parameters":[{"name":"name","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"201":{"description":"Snapshot recorded (held, or rejected on policy violation)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Snapshot"}}}},"404":{"description":"Marketplace not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Snapshot"}}}},"502":{"description":"Upstream fetch failed","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Snapshot"}}}}}}},"/docs":{"get":{"tags":["scalar-controller"],"operationId":"getDocs","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"string"}}}}}}},"/docs/scalar.js":{"get":{"tags":["scalar-controller"],"operationId":"getScalarJs","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"string","format":"byte"}}}}}}},"/api/snapshots/{id}/provenance":{"get":{"tags":["Snapshots"],"summary":"Snapshot provenance","description":"What was served, from where, and who approved it: upstream URL, upstream commit SHA, state, reviewer, and timestamps.","operationId":"provenance","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Provenance record","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Provenance"}}}},"404":{"description":"Snapshot not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Provenance"}}}}}}},"/api/snapshots/{id}/content":{"get":{"tags":["Snapshots"],"summary":"Snapshot content inventory","description":"The plugins declared by the snapshot's marketplace manifest and the skills found under each plugin's source tree — the basis for future per-plugin/per-skill limiting.","operationId":"snapshotContent","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Plugins and skills in the snapshot","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SnapshotContent"}}}},"404":{"description":"Snapshot not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SnapshotContent"}}}}}}},"/api/me":{"get":{"tags":["Session"],"summary":"Current user","description":"Username of the authenticated browser session.","operationId":"me","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}}}}},"/api/audit":{"get":{"tags":["Audit"],"summary":"Fetch audit ledger","description":"Append-only record of every git facade fetch: client source address, authenticated identity, repository, ref, commit SHA, and timestamp. Portal actions are not in this ledger; approvals live in snapshot provenance.","operationId":"audit","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"type":"object","additionalProperties":{}}}}}}}}},"/api/tokens/{id}":{"delete":{"tags":["token-controller"],"operationId":"revoke","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK"}}}}},"components":{"schemas":{"CreateTokenRequest":{"type":"object","properties":{"name":{"type":"string"}}},"IssuedToken":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"name":{"type":"string"},"token":{"type":"string"},"createdAt":{"type":"string","format":"date-time"}}},"Snapshot":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"marketplaceId":{"type":"integer","format":"int64"},"sha":{"type":"string"},"state":{"type":"string"},"violation":{"type":"string"},"createdAt":{"type":"string","format":"date-time"},"decidedBy":{"type":"string"},"decidedAt":{"type":"string","format":"date-time"}}},"RegisterMarketplaceRequest":{"type":"object","properties":{"name":{"type":"string"},"url":{"type":"string"},"ref":{"type":"string"}}},"Marketplace":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"name":{"type":"string"},"url":{"type":"string"},"createdAt":{"type":"string","format":"date-time"},"forge":{"type":"string"},"forgeProject":{"type":"string"},"description":{"type":"string"},"upstreamUpdatedAt":{"type":"string","format":"date-time"}}},"TokenView":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"name":{"type":"string"},"createdAt":{"type":"string","format":"date-time"},"revokedAt":{"type":"string","format":"date-time"}}},"Provenance":{"type":"object","properties":{"snapshotId":{"type":"integer","format":"int64"},"marketplace":{"type":"string"},"upstreamUrl":{"type":"string"},"upstreamSha":{"type":"string"},"state":{"type":"string"},"violation":{"type":"string"},"ingestedAt":{"type":"string","format":"date-time"},"decidedBy":{"type":"string"},"decidedAt":{"type":"string","format":"date-time"}}},"PluginContent":{"type":"object","properties":{"name":{"type":"string"},"description":{"type":"string"},"source":{"type":"string"},"skills":{"type":"array","items":{"$ref":"#/components/schemas/SkillInfo"}}}},"SkillInfo":{"type":"object","properties":{"name":{"type":"string"},"path":{"type":"string"}}},"SnapshotContent":{"type":"object","properties":{"snapshotId":{"type":"integer","format":"int64"},"sha":{"type":"string"},"state":{"type":"string"},"plugins":{"type":"array","items":{"$ref":"#/components/schemas/PluginContent"}}}},"MarketplaceView":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"name":{"type":"string"},"url":{"type":"string"},"createdAt":{"type":"string","format":"date-time"},"forge":{"type":"string"},"forgeProject":{"type":"string"},"description":{"type":"string"},"upstreamUpdatedAt":{"type":"string","format":"date-time"},"snapshots":{"type":"array","items":{"$ref":"#/components/schemas/Snapshot"}}}}}}}