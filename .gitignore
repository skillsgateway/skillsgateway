# Maven
target/
.mvn/wrapper/maven-wrapper.jar

# MkDocs build output
site/

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# Frontend (future SPA)
node_modules/

# Runtime data (bare repos, local dev state)
data/

# OS
.DS_Store
.factorypath
.inlined-pom.xml
.claude/worktrees/
# Per-machine Claude Code settings (hooks, permissions). Ignored here rather
# than relying on a personal global gitignore, which no other checkout has.
.claude/settings.local.json

# Impeccable: per-developer overrides and the hook's dedup cache. The shared
# .impeccable/config.json is committed. Anchored with **/ because the design
# sidecar convention puts an .impeccable/ next to any nested DESIGN.md, and a
# pattern containing a slash otherwise matches only the repository root.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
