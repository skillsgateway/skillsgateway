// Extends the shared @skillsgateway preset; only repository-specific rules
// belong here. The preset silently drops labels that do not exist on this
// repository -- bot-renovate*, renovate-version-* and security are declared in
// skillsgateway/.github, under safe-settings/.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "github>skillsgateway/.github//.github/renovate.json5",
    // Every action by digest, the GitHub-owned ones included.
    "helpers:pinGitHubActionDigests",
  ],

  // Kept from the pre-preset config: the preset adds bot-renovate, addLabels
  // appends rather than replaces.
  addLabels: ["dependencies"],

  // frontend-maven-plugin pins node and pnpm in pom.xml; the wrapper manager
  // keeps ./mvnw itself current.
  "maven-wrapper": {
    enabled: true,
  },

  // The Node that frontend-maven-plugin downloads has no manager of its own.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^pom\\.xml$/"],
      matchStrings: ["<node\\.version>v(?<currentValue>[^<]+)</node\\.version>"],
      depNameTemplate: "node",
      datasourceTemplate: "node-version",
    },
  ],

  packageRules: [
    {
      // @types/node describes the Node the build runs, so the two move in one
      // PR; a lone @types/node major (#727) would type a runtime we do not use.
      description: "Node runtime and @types/node together",
      groupName: "node",
      matchDepNames: ["node", "@types/node"],
      // npm versioning offers a new @types/node major on publish; node
      // versioning holds it until that Node line is LTS, as the runtime is.
      versioning: "node",
    },
    {
      // The image's base layers and the CI service containers by digest, so
      // a release builds from exactly what CI tested. Renovate keeps the
      // digests current.
      description: "Pin container images in the Dockerfile and workflows",
      matchManagers: ["dockerfile", "github-actions"],
      matchDatasources: ["docker"],
      pinDigests: true,
    },
    {
      // The object-storage backend extends org.eclipse.jgit.internal.storage.dfs
      // -- `internal` in the package name is real, and JGit changes those
      // extension points between releases in ways that never affect ordinary
      // Repository/UploadPack use. So a JGit bump arrives on its own, to be
      // reviewed deliberately, rather than inside a group where it would be
      // approved as one line of a larger diff. Pinning is not the mitigation:
      // a pin defers the upgrade without telling us when it breaks us. The
      // storage contract and concurrency suites are the other half.
      description: "JGit alone: the DFS extension points are internal API",
      groupName: "jgit",
      matchPackageNames: ["org.eclipse.jgit{/,}**"],
    },
    {
      // The traceability gate runs reqstool 0.12.0, which pins pygit2==1.20.0,
      // and pygit2 publishes no CPython 3.15 wheel: on 3.15 pip falls back to
      // building it from source against libgit2, which the runner lacks. Lift
      // this once a reqstool release installs from wheels on 3.15.
      description: "Hold Python below 3.15 until reqstool installs on it",
      matchManagers: ["github-actions"],
      matchDepNames: ["python"],
      allowedVersions: "<3.15",
    },
    {
      description: "Group Spring Boot and the Boot-aligned Arconia BOM",
      groupName: "spring boot",
      matchPackageNames: [
        "org.springframework.boot{/,}**",
        "io.arconia{/,}**",
      ],
    },
  ],
}
